<?xml version="1.0" encoding="UTF-8"?>
<manifest>
    <!-- Xiaomi Mi 9T Pro / Redmi K20 Pro (raphael) Local Manifest - LineageOS 19.1 -->
    <!-- Usa os FORKS do jairorossi (com as modificacoes) + vendor no GitLab -->

    <remote name="gitlab" fetch="https://gitlab.com/" />

    <!-- Device Trees (forks com modificacoes do Jairo) -->
    <project name="jairorossi/android_device_xiaomi_raphael" path="device/xiaomi/raphael" remote="github" revision="lineage-19.1" />
    <project name="jairorossi/android_device_xiaomi_sm8150-common" path="device/xiaomi/sm8150-common" remote="github" revision="lineage-19.1" />

    <!-- Kernel Source (fork do Jairo) -->
    <project name="jairorossi/android_kernel_xiaomi_sm8150" path="kernel/xiaomi/sm8150" remote="github" revision="lineage-19.1" />

    <!-- Vendor Blobs (TheMuppets - GitLab, pois a branch lineage-19.1 só existe lá) -->
    <project name="the-muppets/proprietary_vendor_xiaomi" path="vendor/xiaomi" remote="gitlab" revision="lineage-19.1" />

    <!-- Hardware / Xiaomi Common Interfaces (upstream, tem xiaomifingerprint_headers) -->
    <project name="LineageOS/android_hardware_xiaomi" path="hardware/xiaomi" remote="github" revision="lineage-19.1" />

    <!-- MindTheGapps (Android 12.1 / SDK 32) -->
    <project name="MindTheGapps/vendor_gapps" path="vendor/gapps" remote="gitlab" revision="sigma" />

    <!-- Prebuilt apps (APKs grandes, Git LFS) - Miui Gallery, Editor, GBoard, Markup -->
    <project name="jairorossi/vendor_jairo_apps" path="vendor/jairo/apps" remote="github" revision="main" />
</manifest>